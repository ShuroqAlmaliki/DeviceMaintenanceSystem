<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - نظام إدارة صيانة الأجهزة</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DeviceMaintenanceSystem.styles.css" asp-append-version="true" />
</head>

<body>
    <div class="d-flex">

        <aside class="sidebar">
            <div class="sidebar-header">
                <h4>نظام الصيانة</h4>
                <p>إدارة صيانة الأجهزة</p>
            </div>

            <nav class="sidebar-menu">
                <a asp-controller="Home" asp-action="Index">
                    الرئيسية
                </a>

                <a asp-controller="Requests" asp-action="Create">
                    طلب جديد
                </a>

                <a asp-controller="Requests" asp-action="MyRequests">
                    طلباتي
                </a>

                <a asp-controller="Notifications" asp-action="Index">
                    الإشعارات
                </a>

                <a asp-controller="Devices" asp-action="Index">
                    الأجهزة
                </a>
            </nav>
        </aside>

        <div class="main-content">
            <header class="top-header">
                <div>
                    <h5 class="mb-0">@ViewData["Title"]</h5>
                </div>

                <div class="user-area">
                    <span>مرحبًا</span>
                </div>
            </header>

            <main class="page-content">
                @RenderBody()
            </main>

            <footer class="footer">
                <p class="mb-0">
                    © 2026 نظام إدارة صيانة الأجهزة
                </p>
            </footer>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>