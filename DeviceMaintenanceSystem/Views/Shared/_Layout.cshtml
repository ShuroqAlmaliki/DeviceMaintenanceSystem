@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Device Maintenance System
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body>

    <div class="app-layout">

        <!-- =========================================
             SIDEBAR
             ========================================= -->

        <aside class="app-sidebar">

            <!-- =====================================
                 UNIVERSITY BRAND
                 ===================================== -->

            <div class="sidebar-brand">

                <div class="sidebar-logo">

                    <img src="~/images/img22.png"
                         alt="Taif University Logo"
                         class="sidebar-logo-image" />

                </div>

                <div class="sidebar-brand-text">

                    <h2>
                        Taif University
                    </h2>

                    <p>
                        Technical Support Department
                    </p>

                </div>

            </div>

            <!-- =====================================
                 NAVIGATION
                 ===================================== -->

            <nav class="sidebar-navigation">

                <!-- =================================
                     REQUESTER
                     ================================= -->
                @if (User.IsInRole("Requester"))
                {

                    <!-- HOME -->

                    <a asp-controller="Requests"
                       asp-action="Index"
                       class="sidebar-link">

                        <span class="sidebar-icon">

                            <svg viewBox="0 0 24 24">

                                <path d="M3 11.5L12 4l9 7.5" />

                                <path d="M5 10.5V20h14v-9.5" />

                            </svg>

                        </span>

                        <span>
                            Home
                        </span>

                    </a>

                    <!-- NEW REQUEST -->

                    <a asp-controller="MaintenanceRequests"
                       asp-action="Create"
                       class="sidebar-link">

                        <span class="sidebar-icon">

                            <svg viewBox="0 0 24 24">

                                <path d="M12 5v14" />

                                <path d="M5 12h14" />

                            </svg>

                        </span>

                        <span>
                            New Request
                        </span>

                    </a>

                    <!-- MY REQUESTS -->

                    <a asp-controller="MaintenanceRequests"
                       asp-action="Index"
                       class="sidebar-link">

                        <span class="sidebar-icon">

                            <svg viewBox="0 0 24 24">

                                <rect x="5"
                                      y="4"
                                      width="14"
                                      height="16"
                                      rx="2" />

                                <path d="M8 9h8" />

                                <path d="M8 13h8" />

                                <path d="M8 17h5" />

                            </svg>

                        </span>

                        <span>
                            My Requests
                        </span>

                    </a>
                }

                <!-- =================================
                     DEPARTMENT HEAD
                     ================================= -->
                @if (User.IsInRole("DepartmentHead"))
                {

                    <!-- HOME -->

                    <a asp-controller="Approvals"
                       asp-action="Index"
                       class="sidebar-link">

                        <span class="sidebar-icon">

                            <svg viewBox="0 0 24 24">

                                <path d="M3 11.5L12 4l9 7.5" />

                                <path d="M5 10.5V20h14v-9.5" />

                            </svg>

                        </span>

                        <span>
                            Home
                        </span>

                    </a>

                    <!-- MAINTENANCE REQUESTS -->

                    <a asp-controller="MaintenanceRequests"
                       asp-action="Index"
                       class="sidebar-link">

                        <span class="sidebar-icon">

                            <svg viewBox="0 0 24 24">

                                <rect x="5"
                                      y="4"
                                      width="14"
                                      height="16"
                                      rx="2" />

                                <path d="M8 9h8" />

                                <path d="M8 13h8" />

                            </svg>

                        </span>

                        <span>
                            Maintenance Requests
                        </span>

                    </a>
                }

                <!-- =================================
                     MAINTENANCE STAFF
                     ================================= -->
                @if (User.IsInRole("MaintenanceStaff"))
                {

                    <!-- HOME -->

                    <a asp-controller="MaintenanceRequests"
                       asp-action="Index"
                       class="sidebar-link">

                        <span class="sidebar-icon">

                            <svg viewBox="0 0 24 24">

                                <path d="M3 11.5L12 4l9 7.5" />

                                <path d="M5 10.5V20h14v-9.5" />

                            </svg>

                        </span>

                        <span>
                            Home
                        </span>

                    </a>

                    <!-- MY REQUESTS -->

                    <a asp-controller="MaintenanceRequests"
                       asp-action="MyRequests"
                       class="sidebar-link">

                        <span class="sidebar-icon">

                            <svg viewBox="0 0 24 24">

                                <rect x="5"
                                      y="4"
                                      width="14"
                                      height="16"
                                      rx="2" />

                                <path d="M8 9h8" />

                                <path d="M8 13h8" />

                                <path d="M8 17h5" />

                            </svg>

                        </span>

                        <span>
                            My Requests
                        </span>

                    </a>

                    <!-- DEVICES -->

                    <a asp-controller="Devices"
                       asp-action="Index"
                       class="sidebar-link">

                        <span class="sidebar-icon">

                            <svg viewBox="0 0 24 24">

                                <rect x="4"
                                      y="5"
                                      width="16"
                                      height="12"
                                      rx="2" />

                                <path d="M8 21h8" />

                                <path d="M12 17v4" />

                            </svg>

                        </span>

                        <span>
                            Devices
                        </span>

                    </a>

                    <!-- MAINTENANCE HISTORY -->

                    <a asp-controller="MaintenanceLogs"
                       asp-action="Index"
                       class="sidebar-link">

                        <span class="sidebar-icon">

                            <svg viewBox="0 0 24 24">

                                <path d="M5 5h14v14H5z" />

                                <path d="M8 9h8" />

                                <path d="M8 13h8" />

                                <path d="M8 17h5" />

                            </svg>

                        </span>

                        <span>
                            Maintenance History
                        </span>

                    </a>
                }

                <!-- =================================
                     ADMIN
                     ================================= -->
                @if (User.IsInRole("Admin"))
                {

                    <!-- HOME -->

                    <a asp-controller="Admin"
                       asp-action="Index"
                       class="sidebar-link">

                        <span class="sidebar-icon">

                            <svg viewBox="0 0 24 24">

                                <path d="M3 11.5L12 4l9 7.5" />

                                <path d="M5 10.5V20h14v-9.5" />

                            </svg>

                        </span>

                        <span>
                            Home
                        </span>

                    </a>

                    <!-- USERS -->

                    <a asp-controller="Admin"
                       asp-action="Users"
                       class="sidebar-link">

                        <span class="sidebar-icon">

                            <svg viewBox="0 0 24 24">

                                <circle cx="9"
                                        cy="8"
                                        r="3" />

                                <path d="M3 20c0-4 2.5-7 6-7s6 3 6 7" />

                                <circle cx="17"
                                        cy="9"
                                        r="2" />

                                <path d="M16 14c3 0 5 2 5 5" />

                            </svg>

                        </span>

                        <span>
                            User Management
                        </span>

                    </a>

                    <!-- DEPARTMENTS -->

                    <a asp-controller="Departments"
                       asp-action="Index"
                       class="sidebar-link">

                        <span class="sidebar-icon">

                            <svg viewBox="0 0 24 24">

                                <path d="M4 21V5h10v16" />

                                <path d="M14 9h6v12" />

                                <path d="M8 9h2" />

                                <path d="M8 13h2" />

                                <path d="M8 17h2" />

                            </svg>

                        </span>

                        <span>
                            Departments
                        </span>

                    </a>
                }

            </nav>

        </aside>

        <!-- =========================================
             MAIN
             ========================================= -->

        <div class="app-main">

            <!-- HEADER -->

            <header class="app-header">

                <div class="header-actions">

                    @if (User.Identity?.IsAuthenticated == true)
                    {

                        <div class="header-user">

                            <div class="header-avatar">

                                @((User.Identity.Name ?? "U")
                                                                    .Substring(0, 1)
                                                                    .ToUpper())

                            </div>

                            <div class="header-user-info">

                                <span class="header-user-label">
                                    Signed in as
                                </span>

                                <strong>
                                    @User.Identity.Name
                                </strong>

                            </div>

                        </div>
                    }

                    <!-- NOTIFICATIONS -->

                    <a asp-controller="Notifications"
                       asp-action="Index"
                       class="notification-button"
                       title="Notifications">

                        <svg viewBox="0 0 24 24"
                             class="notification-icon">

                            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />

                            <path d="M10 21h4" />

                        </svg>

                    </a>

                    <!-- SIGN OUT -->

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="logout-form">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="logout-button">

                            <svg viewBox="0 0 24 24"
                                 class="logout-icon">

                                <path d="M10 17l5-5-5-5" />

                                <path d="M15 12H3" />

                                <path d="M14 3h5a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-5" />

                            </svg>

                            <span>
                                Sign Out
                            </span>

                        </button>

                    </form>

                </div>

            </header>

            <!-- CONTENT -->

            <main class="app-content">

                @RenderBody()

            </main>

            <!-- FOOTER -->

            <footer class="app-footer">

                Device Maintenance System |
                Taif University © 2026

            </footer>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>
