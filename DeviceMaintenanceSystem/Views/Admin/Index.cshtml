@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="admin-dashboard-page">

    <div class="admin-dashboard-container">

        <!-- PAGE HEADER -->

        <div class="admin-dashboard-header">

            <div>

                <div class="admin-dashboard-label">
                    ADMINISTRATION
                </div>

                <h1>Admin Dashboard</h1>

                <p>
                    Manage users, departments, devices, and maintenance requests.
                </p>

            </div>

        </div>


        <!-- STATISTICS -->

        <div class="admin-stats-grid">

            <div class="admin-stat-card">

                <span>Total Users</span>

                <strong>
                    @ViewBag.TotalUsers
                </strong>

            </div>


            <div class="admin-stat-card">

                <span>Total Departments</span>

                <strong>
                    @ViewBag.TotalDepartments
                </strong>

            </div>


            <div class="admin-stat-card">

                <span>Total Requests</span>

                <strong>
                    @ViewBag.TotalRequests
                </strong>

            </div>


            <div class="admin-stat-card">

                <span>Pending Requests</span>

                <strong>
                    @ViewBag.PendingRequests
                </strong>

            </div>


            <div class="admin-stat-card">

                <span>Approved Requests</span>

                <strong>
                    @ViewBag.ApprovedRequests
                </strong>

            </div>


            <div class="admin-stat-card">

                <span>Rejected Requests</span>

                <strong>
                    @ViewBag.RejectedRequests
                </strong>

            </div>

        </div>


        <!-- DASHBOARD CARDS -->

        <div class="admin-dashboard-grid">


            <!-- USERS -->

            <a asp-controller="Admin"
               asp-action="Users"
               class="admin-dashboard-card">

                <div class="admin-card-icon">

                    <svg viewBox="0 0 24 24">

                        <circle cx="9"
                                cy="8"
                                r="3" />

                        <path d="M3 20c0-4 2.5-7 6-7s6 3 6 7" />

                        <circle cx="17"
                                cy="9"
                                r="2" />

                        <path d="M16 14c3 0 5 2 5 5" />

                    </svg>

                </div>


                <div class="admin-card-content">

                    <h2>Users</h2>

                    <p>
                        View system users and their assigned roles.
                    </p>

                    <span>
                        Manage Users →
                    </span>

                </div>

            </a>


            <!-- DEVICES -->

            <a asp-controller="Devices"
               asp-action="Index"
               class="admin-dashboard-card">

                <div class="admin-card-icon">

                    <svg viewBox="0 0 24 24">

                        <rect x="4"
                              y="5"
                              width="16"
                              height="12"
                              rx="2" />

                        <path d="M8 21h8" />

                        <path d="M12 17v4" />

                    </svg>

                </div>


                <div class="admin-card-content">

                    <h2>Devices</h2>

                    <p>
                        Manage registered devices and their barcodes.
                    </p>

                    <span>
                        Open Devices →
                    </span>

                </div>

            </a>


            <!-- DEPARTMENTS -->

            <a asp-controller="Departments"
               asp-action="Index"
               class="admin-dashboard-card">

                <div class="admin-card-icon">

                    <svg viewBox="0 0 24 24">

                        <path d="M4 21V5h10v16" />

                        <path d="M14 9h6v12" />

                        <path d="M8 9h2" />

                        <path d="M8 13h2" />

                        <path d="M8 17h2" />

                    </svg>

                </div>


                <div class="admin-card-content">

                    <h2>Departments</h2>

                    <p>
                        Manage university departments and department heads.
                    </p>

                    <span>
                        Open Departments →
                    </span>

                </div>

            </a>


            <!-- MAINTENANCE REQUESTS -->

            <a asp-controller="MaintenanceRequests"
               asp-action="Index"
               class="admin-dashboard-card">

                <div class="admin-card-icon">

                    <svg viewBox="0 0 24 24">

                        <rect x="5"
                              y="4"
                              width="14"
                              height="16"
                              rx="2" />

                        <path d="M8 9h8" />

                        <path d="M8 13h8" />

                        <path d="M8 17h5" />

                    </svg>

                </div>


                <div class="admin-card-content">

                    <h2>Maintenance Requests</h2>

                    <p>
                        View and manage submitted maintenance requests.
                    </p>

                    <span>
                        Open Requests →
                    </span>

                </div>

            </a>

        </div>

    </div>

</div>