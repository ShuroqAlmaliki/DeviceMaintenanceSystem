@model IEnumerable<DeviceMaintenanceSystem.Models.MaintenanceLog>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.RequestId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UserId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RepairDetails)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RepairStartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RepairEndDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DeviceStatusAfterRepair)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaintenanceRequest)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.RequestId)
                </td>
                <td>
                    @Html.DisplayFor(model => item.UserId)
                </td>
                <td>
                    @Html.DisplayFor(model => item.RepairDetails)
                </td>
                <td>
                    @Html.DisplayFor(model => item.RepairStartDate)
                </td>
                <td>
                    @Html.DisplayFor(model => item.RepairEndDate)
                </td>
                <td>
                    @Html.DisplayFor(model => item.DeviceStatusAfterRepair)
                </td>
                <td>
                    @Html.DisplayFor(model => item.MaintenanceRequest)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.LogId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.LogId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.LogId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
