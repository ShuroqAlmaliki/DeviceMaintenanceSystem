@model IEnumerable<DeviceMaintenanceSystem.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
    Layout = null;

    var totalNotifications = Model?.Count() ?? 0;
    var unreadNotifications = Model?.Count(x => !x.IsRead) ?? 0;
    var readNotifications = Model?.Count(x => x.IsRead) ?? 0;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Notifications</title>

    <style>

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            html,
            body {
                width: 100%;
                min-height: 100%;
            }

            body {
                font-family: Arial, sans-serif;
                background: #061c4d;
                color: white;
            }

            .notifications-page {
                min-height: 100vh;
                padding: 45px 5%;
                background: radial-gradient( circle at 85% 20%, rgba(39, 143, 255, 0.35), transparent 32% ), linear-gradient( 135deg, #061c4d 0%, #0a3478 55%, #087df5 100% );
            }

            .notifications-container {
                width: 100%;
                max-width: 1450px;
                margin: 0 auto;
            }

            /* TOP BAR */

            .top-bar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 55px;
            }

            .university {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .tu-logo {
                width: 68px;
                height: 68px;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 1px solid rgba(255,255,255,0.25);
                border-radius: 20px;
                background: rgba(255,255,255,0.08);
                font-size: 27px;
                font-weight: 800;
            }

            .university h3 {
                margin-bottom: 5px;
                font-size: 19px;
            }

            .university p {
                color: #9fc6ff;
                font-size: 13px;
            }

            .back-button {
                padding: 12px 22px;
                border: 1px solid rgba(255,255,255,0.22);
                border-radius: 10px;
                background: rgba(255,255,255,0.08);
                color: white;
                text-decoration: none;
                font-size: 14px;
                transition: 0.2s;
            }

                .back-button:hover {
                    background: rgba(255,255,255,0.15);
                }

            /* PAGE HEADER */

            .page-header {
                margin-bottom: 35px;
            }

            .small-title {
                display: inline-block;
                margin-bottom: 16px;
                padding: 8px 17px;
                border: 1px solid rgba(79,157,255,0.55);
                border-radius: 30px;
                background: rgba(30,120,255,0.10);
                color: #67b4ff;
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 1.5px;
            }

            .page-title h1 {
                margin-bottom: 10px;
                font-size: 43px;
                font-weight: 600;
            }

            .page-title p {
                color: #a9c3e9;
                font-size: 15px;
            }

            /* STATISTICS */

            .stats {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 20px;
                margin-bottom: 30px;
            }

            .stat-card {
                display: flex;
                align-items: center;
                gap: 18px;
                min-height: 110px;
                padding: 22px;
                border: 1px solid rgba(118,169,235,0.25);
                border-radius: 18px;
                background: rgba(255,255,255,0.07);
                backdrop-filter: blur(10px);
            }

            .stat-icon {
                width: 55px;
                height: 55px;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                border-radius: 15px;
                background: linear-gradient( 145deg, #0780ff, #61b4ff );
                font-size: 23px;
            }

            .stat-info p {
                margin-bottom: 7px;
                color: #9db7dc;
                font-size: 13px;
            }

            .stat-info h2 {
                font-size: 27px;
            }

            /* NOTIFICATIONS CARD */

            .notifications-card {
                overflow: hidden;
                border: 1px solid rgba(118,169,235,0.22);
                border-radius: 22px;
                background: rgba(4,28,70,0.92);
                box-shadow: 0 20px 50px rgba(0,0,0,0.15);
            }

            .card-header {
                padding: 25px 28px;
                border-bottom: 1px solid rgba(255,255,255,0.08);
            }

                .card-header h2 {
                    margin-bottom: 7px;
                    font-size: 20px;
                }

                .card-header p {
                    color: #879fc5;
                    font-size: 13px;
                }

            /* TABLE */

            .table-wrapper {
                width: 100%;
                overflow-x: auto;
            }

            .notifications-table {
                width: 100%;
                border-collapse: collapse;
            }

                .notifications-table th {
                    padding: 17px 20px;
                    background: rgba(255,255,255,0.05);
                    color: #92add5;
                    text-align: left;
                    font-size: 12px;
                    letter-spacing: 0.4px;
                }

                .notifications-table td {
                    padding: 18px 20px;
                    border-top: 1px solid rgba(255,255,255,0.06);
                    color: #d9e6fa;
                    font-size: 14px;
                }

                .notifications-table tr:hover td {
                    background: rgba(255,255,255,0.03);
                }

            /* STATUS */

            .read-status {
                display: inline-block;
                padding: 6px 11px;
                border-radius: 20px;
                font-size: 12px;
                font-weight: 700;
            }

            .read {
                background: rgba(67,211,146,0.12);
                color: #74e3ae;
            }

            .unread {
                background: rgba(79,157,255,0.15);
                color: #79bdff;
            }

            /* EMPTY STATE */

            .empty-state {
                padding: 65px 20px;
                text-align: center;
            }

            .empty-icon {
                width: 65px;
                height: 65px;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 17px;
                border-radius: 18px;
                background: linear-gradient( 145deg, #0877ff, #65b1ff );
                font-size: 28px;
            }

            .empty-state h3 {
                margin-bottom: 8px;
                font-size: 18px;
            }

            .empty-state p {
                color: #8fa8cd;
                font-size: 13px;
            }

            /* RESPONSIVE */

            @@media (max-width: 900px) {

                .notifications-page {
                    padding: 30px 20px;
                }

                .stats {
                    grid-template-columns: 1fr;
                }

                .page-title h1 {
                    font-size: 34px;
                }
            }

            @@media (max-width: 550px) {

                .top-bar {
                    align-items: flex-start;
                    flex-direction: column;
                    gap: 20px;
                }

                .page-title h1 {
                    font-size: 29px;
                }
            }

    </style>

</head>

<body>

    <div class="notifications-page">

        <div class="notifications-container">

            <!-- TOP BAR -->

            <div class="top-bar">

                <div class="university">

                    <div class="tu-logo">
                        TU
                    </div>

                    <div>
                        <h3>Taif University</h3>
                        <p>Technical Support Department</p>
                    </div>

                </div>

                <a asp-controller="MaintenanceRequests"
                   asp-action="Index"
                   class="back-button">
                    Back to Requests
                </a>

            </div>


            <!-- PAGE HEADER -->

            <div class="page-header">

                <div class="page-title">

                    <div class="small-title">
                        SYSTEM NOTIFICATIONS
                    </div>

                    <h1>Notifications</h1>

                    <p>
                        View your system notifications.
                    </p>

                </div>

            </div>


            <!-- STATISTICS -->

            <div class="stats">

                <div class="stat-card">

                    <div class="stat-icon">
                        🔔
                    </div>

                    <div class="stat-info">
                        <p>Total Notifications</p>
                        <h2>@totalNotifications</h2>
                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-icon">
                        ●
                    </div>

                    <div class="stat-info">
                        <p>Unread</p>
                        <h2>@unreadNotifications</h2>
                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-icon">
                        ✓
                    </div>

                    <div class="stat-info">
                        <p>Read</p>
                        <h2>@readNotifications</h2>
                    </div>

                </div>

            </div>


            <!-- NOTIFICATIONS LIST -->

            <div class="notifications-card">

                <div class="card-header">

                    <h2>Notifications List</h2>

                    <p>
                        Your notifications registered in the system.
                    </p>

                </div>


                @if (Model != null && Model.Any())
                {
                    <div class="table-wrapper">

                        <table class="notifications-table">

                            <thead>

                                <tr>
                                   
                                    <th>Request ID</th>
                                    <th>Description</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var item in Model)
                                {
                                    <tr>

                                       

                                        <td>
                                            #@item.RequestId
                                        </td>

                                        <td>
                                            @item.NotificationDescription
                                        </td>

                                        <td>
                                            @item.NotificationDate.ToString("dd/MM/yyyy")
                                        </td>

                                        <td>

                                            @if (item.IsRead)
                                            {
                                                <span class="read-status read">
                                                    Read
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="read-status unread">
                                                    Unread
                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="empty-state">

                        <div class="empty-icon">
                            🔔
                        </div>

                        <h3>No notifications yet</h3>

                        <p>
                            Your system notifications will appear here automatically.
                        </p>

                    </div>
                }

            </div>

        </div>

    </div>

</body>

</html>