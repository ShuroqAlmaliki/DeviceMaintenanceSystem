@model IEnumerable<DeviceMaintenanceSystem.Models.Notification>

@{
    ViewData["Title"] = "Notifications";

    var totalNotifications = Model?.Count() ?? 0;
    var unreadNotifications = Model?.Count(x => !x.IsRead) ?? 0;
    var readNotifications = Model?.Count(x => x.IsRead) ?? 0;
}

<div class="notifications-page">
    <div class="notifications-container">

        <div class="page-header">
            <div class="page-title">
                <div class="small-title">
                    SYSTEM NOTIFICATIONS
                </div>

                <h1>Notifications</h1>

                <p>
                    View your system notifications.
                </p>
            </div>
        </div>

        <div class="stats">

            <div class="stat-card">
                <div class="stat-icon">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
                        <path d="M10 21h4" />
                    </svg>
                </div>

                <div class="stat-info">
                    <p>Total Notifications</p>
                    <h2>@totalNotifications</h2>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <circle cx="12" cy="12" r="8" />
                        <circle cx="12" cy="12" r="2" fill="currentColor" stroke="none" />
                    </svg>
                </div>

                <div class="stat-info">
                    <p>Unread</p>
                    <h2>@unreadNotifications</h2>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M5 12l4 4L19 6" />
                    </svg>
                </div>

                <div class="stat-info">
                    <p>Read</p>
                    <h2>@readNotifications</h2>
                </div>
            </div>

        </div>

        <div class="notifications-card">

            <div class="card-header">
                <h2>Notifications List</h2>
                <p>Your notifications registered in the system.</p>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="table-wrapper">
                    <table class="notifications-table">
                        <thead>
                            <tr>
                                <th>Request ID</th>
                                <th>Description</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>#@item.RequestId</td>

                                    <td>@item.NotificationDescription</td>

                                    <td>@item.NotificationDate.ToString("dd/MM/yyyy")</td>

                                    <td>
                                        @if (item.IsRead)
                                        {
                                            <span class="read-status read">Read</span>
                                        }
                                        else
                                        {
                                            <span class="read-status unread">Unread</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
                            <path d="M10 21h4" />
                        </svg>
                    </div>

                    <h3>No notifications yet</h3>

                    <p>
                        Your system notifications will appear here automatically.
                    </p>
                </div>
            }

        </div>

    </div>
</div>
