@model DeviceMaintenanceSystem.Models.MaintenanceLog

@{
    ViewData["Title"] = "Finish Maintenance";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="log-form-page">

    <div class="log-form-container">


        <!-- HEADER -->

        <div class="log-form-header">

            <div>

                <div class="logs-label">
                    TECHNICIAN WORKSPACE
                </div>

                <h1>
                    Finish Maintenance
                </h1>

                <p>
                    Record the repair details and complete this maintenance request.
                </p>

            </div>


            <a asp-controller="MaintenanceRequests"
               asp-action="MyRequests"
               class="log-back-button">

                ← Back to My Requests

            </a>

        </div>


        <!-- REQUEST INFORMATION -->

        <div class="log-form-card">

            <div class="log-form-card-header">

                <h2>
                    Request Information
                </h2>

                <p>
                    Review the request before completing the maintenance.
                </p>

            </div>


            <div style="padding: 25px 30px; border-bottom: 1px solid #e9eef5;">

                <div class="log-form-grid">

                    <div class="log-field">

                        <label>
                            Request ID
                        </label>

                        <input value="#@ViewBag.RequestId"
                               class="log-input"
                               readonly />

                    </div>


                    <div class="log-field">

                        <label>
                            Device
                        </label>

                        <input value="@ViewBag.DeviceName"
                               class="log-input"
                               readonly />

                    </div>


                    <div class="log-field log-field-full">

                        <label>
                            Reported Issue
                        </label>

                        <input value="@ViewBag.RequestDescription"
                               class="log-input"
                               readonly />

                    </div>

                </div>

            </div>


            <!-- FORM -->

            <form asp-controller="MaintenanceLogs"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()


                <input type="hidden"
                       asp-for="RequestId" />


                <div asp-validation-summary="ModelOnly"
                     class="log-validation-summary">
                </div>


                <div class="log-form-grid">


                    <!-- REPAIR DETAILS -->

                    <div class="log-field log-field-full">

                        <label asp-for="RepairDetails">
                            Repair Details
                        </label>

                        <textarea asp-for="RepairDetails"
                                  class="log-input log-textarea"
                                  placeholder="Describe the repair work performed..."></textarea>

                        <span asp-validation-for="RepairDetails"
                              class="log-validation">
                        </span>

                    </div>


                    <!-- START DATE -->

                    <div class="log-field">

                        <label asp-for="RepairStartDate">
                            Repair Start Date
                        </label>

                        <input asp-for="RepairStartDate"
                               type="datetime-local"
                               class="log-input" />

                        <span asp-validation-for="RepairStartDate"
                              class="log-validation">
                        </span>

                    </div>


                    <!-- END DATE -->

                    <div class="log-field">

                        <label asp-for="RepairEndDate">
                            Repair End Date
                        </label>

                        <input asp-for="RepairEndDate"
                               type="datetime-local"
                               class="log-input" />

                        <span asp-validation-for="RepairEndDate"
                              class="log-validation">
                        </span>

                    </div>


                    <!-- DEVICE STATUS -->

                    <div class="log-field log-field-full">

                        <label asp-for="DeviceStatusAfterRepair">
                            Device Status After Repair
                        </label>

                        <select asp-for="DeviceStatusAfterRepair"
                                class="log-input">

                            <option value="">
                                Select Device Status
                            </option>

                            <option value="Active">
                                Active
                            </option>

                            <option value="Needs Further Maintenance">
                                Needs Further Maintenance
                            </option>

                            <option value="Out of Service">
                                Out of Service
                            </option>

                        </select>

                        <span asp-validation-for="DeviceStatusAfterRepair"
                              class="log-validation">
                        </span>

                    </div>

                </div>


                <div class="log-form-actions">

                    <button type="submit"
                            class="log-primary-button">

                        Finish Maintenance

                    </button>


                    <a asp-controller="MaintenanceRequests"
                       asp-action="MyRequests"
                       class="log-secondary-button">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}