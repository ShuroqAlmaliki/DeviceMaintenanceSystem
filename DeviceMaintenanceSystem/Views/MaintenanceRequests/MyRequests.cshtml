@model IEnumerable<DeviceMaintenanceSystem.Models.MaintenanceRequest>

@{
    ViewData["Title"] = "My Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var activeRequests =
        Model?
            .Where(x =>
                x.RequestStatus != null &&
                x.RequestStatus.ToLower() == "in progress")
            .OrderByDescending(x => x.AssignedDate)
            .ToList()
        ?? new List<DeviceMaintenanceSystem.Models.MaintenanceRequest>();

    var activeCount =
        activeRequests.Count;

    var assignedToday =
        activeRequests.Count(x =>
            x.AssignedDate.HasValue &&
            x.AssignedDate.Value.Date == DateTime.Today);
}


<div class="requests-page">

    <div class="requests-container">


        <!-- HEADER -->

        <div class="page-header">

            <div class="page-title">

                <div class="small-title">
                    TECHNICIAN WORKSPACE
                </div>

                <h1>
                    My Requests
                </h1>

                <p>
                    Maintenance requests currently assigned to you.
                </p>

            </div>

        </div>


        <!-- STATISTICS -->

        <div class="stats">

            <div class="stat-card">

                <div class="stat-icon">
                    📋
                </div>

                <div class="stat-info">

                    <p>
                        Active Requests
                    </p>

                    <h2>
                        @activeCount
                    </h2>

                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon">
                    ⏳
                </div>

                <div class="stat-info">

                    <p>
                        In Progress
                    </p>

                    <h2>
                        @activeCount
                    </h2>

                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon">
                    ✓
                </div>

                <div class="stat-info">

                    <p>
                        Assigned Today
                    </p>

                    <h2>
                        @assignedToday
                    </h2>

                </div>

            </div>

        </div>


        <!-- CURRENT WORK -->

        <div class="requests-card">

            <div class="card-header">

                <h2>
                    Current Work
                </h2>

                <p>
                    Requests you are currently working on.
                </p>

            </div>


            @if (activeRequests.Any())
            {
                <div class="table-wrapper">

                    <table class="requests-table">

                        <thead>

                            <tr>

                                <th>Request ID</th>

                                <th>User</th>

                                <th>Device</th>

                                <th>Description</th>

                                <th>Status</th>

                                <th>Assigned Date</th>

                                <th>Action</th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in activeRequests)
                            {
                                <tr>

                                    <td>
                                        #@item.RequestId
                                    </td>


                                    <td>
                                        @item.UserId
                                    </td>


                                    <td>
                                        @(item.Device?.DeviceName ?? "Unknown Device")
                                    </td>


                                    <td>
                                        @item.RequestDescription
                                    </td>


                                    <td>

                                        <span class="status">
                                            In Progress
                                        </span>

                                    </td>


                                    <td>

                                        @if (item.AssignedDate.HasValue)
                                        {
                                            @item.AssignedDate.Value.ToString("dd/MM/yyyy HH:mm")
                                        }

                                        @if (!item.AssignedDate.HasValue)
                                        {
                                            <text>-</text>
                                        }

                                    </td>


                                    <td>

                                        <a asp-controller="MaintenanceLogs"
                                           asp-action="Create"
                                           asp-route-requestId="@item.RequestId"
                                           class="approve-btn">

                                            Finish Maintenance

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }


            @if (!activeRequests.Any())
            {
                <div class="empty-state">

                    <div class="empty-icon">
                        🛠
                    </div>

                    <h3>
                        No active requests
                    </h3>

                    <p>
                        Take a request from Home to start working on it.
                    </p>

                </div>
            }

        </div>

    </div>

</div>