@model DeviceMaintenanceSystem.Models.MaintenanceRequest

@{
    ViewData["Title"] = "Create Maintenance Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="create-page">

    <div class="create-container">


        <!-- =========================================
             PAGE HEADER
             ========================================= -->

        <div class="page-header">

            <div>

                <div class="small-title">
                    NEW MAINTENANCE REQUEST
                </div>

                <h1>
                    Create Request
                </h1>

                <p>
                    Enter the maintenance request details below.
                </p>

            </div>

        </div>


        <!-- =========================================
             FORM CARD
             ========================================= -->

        <div class="form-card">

            <div class="form-card-header">

                <h2>
                    Request Information
                </h2>

                <p>
                    Enter the device and applicant information below.
                </p>

            </div>


            <form asp-controller="MaintenanceRequests"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()


                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>


                <div class="form-grid">


                    <!-- =================================
                         DEVICE NAME
                         ================================= -->

                    <div class="form-group full-width">

                        <label asp-for="DeviceName">
                            Device Name
                        </label>

                        <input asp-for="DeviceName"
                               type="text"
                               class="form-control"
                               placeholder="Enter device name..." />

                        <span asp-validation-for="DeviceName"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =================================
                         DESCRIPTION
                         ================================= -->

                    <div class="form-group full-width">

                        <label asp-for="RequestDescription">
                            Request Description
                        </label>

                        <textarea asp-for="RequestDescription"
                                  class="form-control"
                                  placeholder="Describe the maintenance issue..."></textarea>

                        <span asp-validation-for="RequestDescription"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =================================
                         PHONE NUMBER
                         ================================= -->

                    <div class="form-group">

                        <label asp-for="ApplicantPhone">
                            Phone Number
                        </label>

                        <input asp-for="ApplicantPhone"
                               type="text"
                               class="form-control"
                               placeholder="05xxxxxxxx" />

                        <span asp-validation-for="ApplicantPhone"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =================================
                         OFFICE NUMBER
                         ================================= -->

                    <div class="form-group">

                        <label asp-for="OfficeNumber">
                            Office Number
                        </label>

                        <input asp-for="OfficeNumber"
                               type="text"
                               class="form-control"
                               placeholder="Enter office number..." />

                        <span asp-validation-for="OfficeNumber"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =================================
                         DEPARTMENT
                         ================================= -->

                    <div class="form-group">

                        <label asp-for="Department">
                            Department
                        </label>

                        <input asp-for="Department"
                               type="text"
                               class="form-control"
                               placeholder="Enter department name..." />

                        <span asp-validation-for="Department"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =================================
                         BUILDING
                         ================================= -->

                    <div class="form-group">

                        <label asp-for="Building">
                            Building
                        </label>

                        <input asp-for="Building"
                               type="text"
                               class="form-control"
                               placeholder="Enter building..." />

                        <span asp-validation-for="Building"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- =================================
                         NOTE
                         ================================= -->

                    <div class="request-note">

                        Request date and status are generated automatically.

                    </div>

                </div>


                <!-- =================================
                     ACTIONS
                     ================================= -->

                <div class="form-actions">

                    <button type="submit"
                            class="create-button">

                        Create Request

                    </button>


                    <a asp-controller="Requests"
                       asp-action="Index"
                       class="cancel-button">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}