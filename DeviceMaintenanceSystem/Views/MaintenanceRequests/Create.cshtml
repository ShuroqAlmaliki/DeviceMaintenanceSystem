@model DeviceMaintenanceSystem.Models.MaintenanceRequest

@{
    ViewData["Title"] = "Create Maintenance Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Create Maintenance Request</title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <div class="create-page">

        <div class="create-container">

            <div class="top-bar">

                <div class="university">

                    <div class="tu-logo">
                        TU
                    </div>

                    <div>
                        <h3>Taif University</h3>
                        <p>Technical Support Department</p>
                    </div>

                </div>

                <a asp-action="Index"
                   class="back-button">
                    ← Back to Requests
                </a>

            </div>


            <div class="page-header">

                <div class="small-title">
                    NEW MAINTENANCE REQUEST
                </div>

                <h1>Create Request</h1>

                <p>
                    Enter the maintenance request details below.
                </p>

            </div>


            <div class="form-card">

                <div class="form-card-header">

                    <h2>Request Information</h2>

                    <p>
                        Select the device and describe the maintenance issue.
                    </p>

                </div>


                <form asp-controller="MaintenanceRequests"
                      asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger">
                    </div>


                    <div class="form-grid">

                        <!-- DEVICE NAME -->

                        <div class="form-group full-width">

                            <label asp-for="DeviceId">
                                Device Name
                            </label>

                            <select asp-for="DeviceId"
                                    asp-items="ViewBag.Devices"
                                    class="form-control">

                                <option value="">
                                    Select Device
                                </option>

                            </select>

                            <span asp-validation-for="DeviceId"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- DESCRIPTION -->

                        <div class="form-group full-width">

                            <label asp-for="RequestDescription">
                                Request Description
                            </label>

                            <textarea asp-for="RequestDescription"
                                      class="form-control"
                                      placeholder="Describe the maintenance issue..."></textarea>

                            <span asp-validation-for="RequestDescription"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="request-note">
                            Request date and request status are generated automatically.
                        </div>

                    </div>


                    <div class="form-actions">

                        <button type="submit"
                                class="create-button">
                            Create Request
                        </button>

                        <a asp-action="Index"
                           class="cancel-button">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</body>

</html>