@model DeviceMaintenanceSystem.Models.MaintenanceRequest

@{
    ViewData["Title"] = "Create";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Create Maintenance Request</title>

    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            html,
            body {
                width: 100%;
                min-height: 100%;
            }

            body {
                font-family: Arial, sans-serif;
                background: #061c4d;
                color: white;
            }

            .create-page {
                min-height: 100vh;
                padding: 45px 5%;
                background: radial-gradient( circle at 85% 20%, rgba(39, 143, 255, 0.35), transparent 32% ), linear-gradient( 135deg, #061c4d 0%, #0a3478 55%, #087df5 100% );
            }

            .create-container {
                width: 100%;
                max-width: 1180px;
                margin: 0 auto;
            }

            .top-bar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 45px;
            }

            .university {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .tu-logo {
                width: 68px;
                height: 68px;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 1px solid rgba(255,255,255,0.25);
                border-radius: 20px;
                background: rgba(255,255,255,0.08);
                font-size: 27px;
                font-weight: 800;
            }

            .university h3 {
                margin-bottom: 5px;
                font-size: 19px;
            }

            .university p {
                color: #9fc6ff;
                font-size: 13px;
            }

            .back-button {
                padding: 12px 22px;
                border: 1px solid rgba(255,255,255,0.22);
                border-radius: 10px;
                background: rgba(255,255,255,0.08);
                color: white;
                text-decoration: none;
                font-size: 14px;
            }

                .back-button:hover {
                    background: rgba(255,255,255,0.15);
                }

            .page-header {
                margin-bottom: 28px;
            }

            .small-title {
                display: inline-block;
                margin-bottom: 16px;
                padding: 8px 17px;
                border: 1px solid rgba(79,157,255,0.55);
                border-radius: 30px;
                background: rgba(30,120,255,0.10);
                color: #67b4ff;
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 1.5px;
            }

            .page-header h1 {
                margin-bottom: 10px;
                font-size: 43px;
                font-weight: 600;
            }

            .page-header p {
                color: #a9c3e9;
                font-size: 15px;
            }

            .form-card {
                padding: 34px;
                border: 1px solid rgba(118,169,235,0.22);
                border-radius: 22px;
                background: rgba(4,28,70,0.92);
                box-shadow: 0 20px 50px rgba(0,0,0,0.15);
            }

            .form-card-header {
                margin-bottom: 28px;
            }

                .form-card-header h2 {
                    margin-bottom: 7px;
                    font-size: 21px;
                }

                .form-card-header p {
                    color: #879fc5;
                    font-size: 13px;
                }

            .form-grid {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 22px;
            }

            .form-group {
                display: flex;
                flex-direction: column;
            }

            .full-width {
                grid-column: 1 / -1;
            }

            .form-group label {
                margin-bottom: 8px;
                color: #d7e6fb;
                font-size: 13px;
                font-weight: 700;
            }

            .form-control {
                width: 100%;
                height: 52px;
                padding: 0 15px;
                border: 1px solid rgba(95,150,220,0.35);
                border-radius: 10px;
                outline: none;
                background: #061b43;
                color: white;
                font-size: 14px;
            }

            textarea.form-control {
                min-height: 145px;
                padding: 15px;
                resize: vertical;
            }

            .form-control:focus {
                border-color: #4f9dff;
                box-shadow: 0 0 0 3px rgba(79,157,255,0.12);
            }

            .text-danger {
                margin-top: 6px;
                color: #ff9f9f;
                font-size: 11px;
            }

            .request-note {
                grid-column: 1 / -1;
                padding: 15px 18px;
                border: 1px solid rgba(79,157,255,0.18);
                border-radius: 11px;
                background: rgba(79,157,255,0.07);
                color: #9fc6f5;
                font-size: 12px;
                line-height: 1.6;
            }

            .form-actions {
                display: flex;
                gap: 12px;
                margin-top: 30px;
            }

            .create-button {
                min-width: 155px;
                height: 48px;
                border: none;
                border-radius: 10px;
                background: linear-gradient(90deg, #0877ff, #65b1ff);
                color: white;
                font-size: 14px;
                font-weight: 700;
                cursor: pointer;
            }

                .create-button:hover {
                    transform: translateY(-2px);
                }

            .cancel-button {
                min-width: 120px;
                height: 48px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border: 1px solid rgba(255,255,255,0.20);
                border-radius: 10px;
                background: rgba(255,255,255,0.06);
                color: white;
                text-decoration: none;
                font-size: 14px;
            }

                .cancel-button:hover {
                    background: rgba(255,255,255,0.12);
                }

            @@media (max-width: 800px) {
                .create-page {
                    padding: 30px 20px;
                }

                .form-grid {
                    grid-template-columns: 1fr;
                }

                .full-width,
                .request-note {
                    grid-column: auto;
                }

                .top-bar {
                    align-items: flex-start;
                    flex-direction: column;
                    gap: 20px;
                }

                .page-header h1 {
                    font-size: 34px;
                }
            }
    </style>
</head>

<body>

    <div class="create-page">

        <div class="create-container">

            <div class="top-bar">

                <div class="university">

                    <div class="tu-logo">
                        TU
                    </div>

                    <div>
                        <h3>Taif University</h3>
                        <p>Technical Support Department</p>
                    </div>

                </div>

                <a asp-action="Index"
                   class="back-button">
                    ← Back to Requests
                </a>

            </div>

            <div class="page-header">

                <div class="small-title">
                    NEW MAINTENANCE REQUEST
                </div>

                <h1>Create Request</h1>

                <p>
                    Enter the maintenance request details below.
                </p>

            </div>

            <div class="form-card">

                <div class="form-card-header">

                    <h2>Request Information</h2>

                    <p>
                        Fill in the information below to submit a maintenance request.
                    </p>

                </div>

                <form asp-action="Create"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger">
                    </div>

                    <div class="form-grid">

                        <div class="form-group">

                            <label asp-for="UserId">
                                User ID
                            </label>

                            <input asp-for="UserId"
                                   class="form-control"
                                   placeholder="Enter user ID" />

                            <span asp-validation-for="UserId"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="form-group">

                            <label asp-for="DeviceId">
                                Device ID
                            </label>

                            <input asp-for="DeviceId"
                                   class="form-control"
                                   placeholder="Enter device ID" />

                            <span asp-validation-for="DeviceId"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="form-group full-width">

                            <label asp-for="RequestDescription">
                                Request Description
                            </label>

                            <textarea asp-for="RequestDescription"
                                      class="form-control"
                                      placeholder="Describe the maintenance issue..."></textarea>

                            <span asp-validation-for="RequestDescription"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="request-note">
                            The request date and status will be generated automatically.
                            New requests will be submitted with Pending status.
                        </div>

                    </div>

                    <div class="form-actions">

                        <button type="submit"
                                class="create-button">
                            Create Request
                        </button>

                        <a asp-action="Index"
                           class="cancel-button">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</body>
</html>