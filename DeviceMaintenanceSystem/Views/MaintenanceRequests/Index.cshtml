@model IEnumerable<DeviceMaintenanceSystem.Models.MaintenanceRequest>

@{
    ViewData["Title"] = "Maintenance Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var totalRequests = Model?.Count() ?? 0;

    var pendingRequests = Model?.Count(x =>
        x.RequestStatus != null &&
        x.RequestStatus.ToLower() == "pending") ?? 0;

    var approvedRequests = Model?.Count(x =>
        x.RequestStatus != null &&
        x.RequestStatus.ToLower() == "approved") ?? 0;

    var completedRequests = Model?.Count(x =>
        x.RequestStatus != null &&
        x.RequestStatus.ToLower() == "completed") ?? 0;
}


<div class="requests-page">

    <div class="requests-container">


        <!-- =========================================
             PAGE HEADER
             ========================================= -->

        <div class="page-header">

            <div class="page-title">

                <div class="small-title">

                    @if (User.IsInRole("MaintenanceStaff"))
                    {
                        <text>TECHNICIAN WORKSPACE</text>
                    }

                    @if (!User.IsInRole("MaintenanceStaff"))
                    {
                        <text>MAINTENANCE MANAGEMENT</text>
                    }

                </div>


                <h1>

                    @if (User.IsInRole("MaintenanceStaff"))
                    {
                        <text>Available Requests</text>
                    }

                    @if (!User.IsInRole("MaintenanceStaff"))
                    {
                        <text>Maintenance Requests</text>
                    }

                </h1>


                <p>

                    @if (User.IsInRole("MaintenanceStaff"))
                    {
                        <text>
                            Select an approved maintenance request to start working on it.
                        </text>
                    }

                    @if (!User.IsInRole("MaintenanceStaff"))
                    {
                        <text>
                            View and manage submitted maintenance requests.
                        </text>
                    }

                </p>

            </div>


            <!-- NEW REQUEST - REQUESTER ONLY -->
            @if (User.IsInRole("Requester"))
            {
                <a asp-controller="MaintenanceRequests"
                   asp-action="Create"
                   class="new-request">

                    New Request

                    <span>
                        ＋
                    </span>

                </a>
            }

        </div>


        <!-- =========================================
             STATISTICS
             ========================================= -->

        <div class="stats">


            <!-- TOTAL / AVAILABLE -->

            <div class="stat-card">

                <div class="stat-icon">
                    📋
                </div>

                <div class="stat-info">

                    <p>

                        @if (User.IsInRole("MaintenanceStaff"))
                        {
                            <text>Available Requests</text>
                        }

                        @if (!User.IsInRole("MaintenanceStaff"))
                        {
                            <text>Total Requests</text>
                        }

                    </p>

                    <h2>
                        @totalRequests
                    </h2>

                </div>

            </div>


            <!-- PENDING / APPROVED -->

            <div class="stat-card">

                <div class="stat-icon">
                    ⏳
                </div>

                <div class="stat-info">

                    <p>

                        @if (User.IsInRole("MaintenanceStaff"))
                        {
                            <text>Approved</text>
                        }

                        @if (!User.IsInRole("MaintenanceStaff"))
                        {
                            <text>Pending</text>
                        }

                    </p>

                    <h2>

                        @if (User.IsInRole("MaintenanceStaff"))
                        {
                            @approvedRequests
                        }

                        @if (!User.IsInRole("MaintenanceStaff"))
                        {
                            @pendingRequests
                        }

                    </h2>

                </div>

            </div>


            <!-- COMPLETED -->

            <div class="stat-card">

                <div class="stat-icon">
                    ✓
                </div>

                <div class="stat-info">

                    <p>
                        Completed
                    </p>

                    <h2>
                        @completedRequests
                    </h2>

                </div>

            </div>

        </div>


        <!-- =========================================
             REQUESTS LIST
             ========================================= -->

        <div class="requests-card">

            <div class="card-header">

                <h2>

                    @if (User.IsInRole("MaintenanceStaff"))
                    {
                        <text>Available Requests</text>
                    }

                    @if (!User.IsInRole("MaintenanceStaff"))
                    {
                        <text>Requests List</text>
                    }

                </h2>


                <p>

                    @if (User.IsInRole("MaintenanceStaff"))
                    {
                        <text>
                            Approved requests that have not been assigned to a technician yet.
                        </text>
                    }

                    @if (!User.IsInRole("MaintenanceStaff"))
                    {
                        <text>
                            All maintenance requests registered in the system.
                        </text>
                    }

                </p>

            </div>


            @if (Model != null && Model.Any())
            {
                <div class="table-wrapper">

                    <table class="requests-table">

                        <thead>

                            <tr>

                                <th>
                                    Request ID
                                </th>

                                <th>
                                    User Name
                                </th>

                                <th>
                                    Device Name
                                </th>

                                <th>
                                    Description
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Date
                                </th>


                                @if (
                                    User.IsInRole("MaintenanceStaff") ||
                                    User.IsInRole("DepartmentHead")
                                )
                                {
                                    <th>
                                        Actions
                                    </th>
                                }

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>


                                    <!-- REQUEST ID -->

                                    <td>
                                        #@item.RequestId
                                    </td>


                                    <!-- USER -->

                                    <td>
                                        @item.UserId
                                    </td>


                                    <!-- DEVICE NAME -->

                                    <td>

                                        @(!string.IsNullOrEmpty(item.DeviceName) ? item.DeviceName : (item.Device?.DeviceName ?? "Unknown Device"))

                                    </td>


                                    <!-- DESCRIPTION -->

                                    <td>
                                        @item.RequestDescription
                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        <span class="status">
                                            @item.RequestStatus
                                        </span>

                                    </td>


                                    <!-- DATE -->

                                    <td>
                                        @item.RequestDate.ToString("dd/MM/yyyy")
                                    </td>


                                    <!-- =========================================
                                         ACTIONS - TECHNICIAN / DEPARTMENT HEAD
                                         ========================================= -->
                                    @if (
                                                                            User.IsInRole("MaintenanceStaff") ||
                                                                            User.IsInRole("DepartmentHead")
                                                                        )
                                    {
                                        <td>


                                            <!-- MAINTENANCE STAFF -->
                                            @if (User.IsInRole("MaintenanceStaff"))
                                            {
                                                <form asp-controller="MaintenanceRequests"
                                                      asp-action="TakeRequest"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="requestid"
                                                           value="@item.RequestId" />

                                                    <button type="submit"
                                                            class="approve-btn">

                                                        Take Request

                                                    </button>

                                                </form>
                                            }


                                            <!-- DEPARTMENT HEAD - PENDING -->
                                            @if (
                                                                                            User.IsInRole("DepartmentHead") &&
                                                                                            item.RequestStatus != null &&
                                                                                            item.RequestStatus.ToLower() == "pending"
                                                                                        )
                                            {
                                                <div class="actions">


                                                    <!-- APPROVE -->

                                                    <form asp-controller="MaintenanceRequests"
                                                          asp-action="Approve"
                                                          method="post">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="requestid"
                                                               value="@item.RequestId" />

                                                        <button type="submit"
                                                                class="approve-btn">

                                                            Approve

                                                        </button>

                                                    </form>


                                                    <!-- REJECT -->

                                                    <form asp-controller="MaintenanceRequests"
                                                          asp-action="Reject"
                                                          method="post">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="requestid"
                                                               value="@item.RequestId" />

                                                        <button type="submit"
                                                                class="reject-btn">

                                                            Reject

                                                        </button>

                                                    </form>

                                                </div>
                                            }


                                            <!-- DEPARTMENT HEAD - PROCESSED -->
                                            @if (
                                                                                            User.IsInRole("DepartmentHead") &&
                                                                                            (
                                                                                                item.RequestStatus == null ||
                                                                                                item.RequestStatus.ToLower() != "pending"
                                                                                            )
                                                                                        )
                                            {
                                                <span class="processed-text">

                                                    @(item.RequestStatus ?? "Processed")

                                                </span>
                                            }

                                        </td>
                                    }

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }


            @if (Model == null || !Model.Any())
            {
                <div class="empty-state">

                    <div class="empty-icon">
                        🛠
                    </div>


                    @if (User.IsInRole("MaintenanceStaff"))
                    {
                        <h3>
                            No available requests
                        </h3>

                        <p>
                            All approved maintenance requests have been assigned.
                            New approved requests will appear here automatically.
                        </p>
                    }


                    @if (!User.IsInRole("MaintenanceStaff"))
                    {
                        <h3>
                            No maintenance requests yet
                        </h3>

                        <p>
                            New maintenance requests will appear here.
                        </p>
                    }

                </div>
            }

        </div>

    </div>

</div>