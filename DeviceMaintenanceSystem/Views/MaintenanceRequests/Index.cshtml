@model IEnumerable<DeviceMaintenanceSystem.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
    Layout = null;

    var totalNotifications = Model?.Count() ?? 0;
    var unreadNotifications = Model?.Count(x => !x.IsRead) ?? 0;
    var readNotifications = Model?.Count(x => x.IsRead) ?? 0;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Notifications</title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body>

    <div class="notifications-page">

        <div class="notifications-container">

            <!-- TOP BAR -->

            <div class="top-bar">

                <div class="university">

                    <div class="tu-logo">
                        TU
                    </div>

                    <div>
                        <h3>Taif University</h3>
                        <p>Technical Support Department</p>
                    </div>

                </div>

                <a asp-controller="MaintenanceRequests"
                   asp-action="Index"
                   class="back-button">
                    Back to Requests
                </a>

            </div>


            <!-- PAGE HEADER -->

            <div class="page-header">

                <div class="page-title">

                    <div class="small-title">
                        SYSTEM NOTIFICATIONS
                    </div>

                    <h1>Notifications</h1>

                    <p>
                        View your system notifications.
                    </p>

                </div>

            </div>


            <!-- STATISTICS -->

            <div class="stats">

                <div class="stat-card">

                    <div class="stat-icon">
                        🔔
                    </div>

                    <div class="stat-info">
                        <p>Total Notifications</p>
                        <h2>@totalNotifications</h2>
                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-icon">
                        ●
                    </div>

                    <div class="stat-info">
                        <p>Unread</p>
                        <h2>@unreadNotifications</h2>
                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-icon">
                        ✓
                    </div>

                    <div class="stat-info">
                        <p>Read</p>
                        <h2>@readNotifications</h2>
                    </div>

                </div>

            </div>


            <!-- NOTIFICATIONS LIST -->

            <div class="notifications-card">

                <div class="card-header">

                    <h2>Notifications List</h2>

                    <p>
                        Your notifications registered in the system.
                    </p>

                </div>


                @if (Model != null && Model.Any())
                {
                    <div class="table-wrapper">

                        <table class="notifications-table">

                            <thead>

                                <tr>
                                    <th>ID</th>
                                    <th>Request ID</th>
                                    <th>Description</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var item in Model)
                                {
                                    <tr>

                                        <td>
                                            #@item.NotificationId
                                        </td>

                                        <td>
                                            #@item.RequestId
                                        </td>

                                        <td>
                                            @item.NotificationDescription
                                        </td>

                                        <td>
                                            @item.NotificationDate.ToString("dd/MM/yyyy")
                                        </td>

                                        <td>

                                            @if (item.IsRead)
                                            {
                                                <span class="read-status read">
                                                    Read
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="read-status unread">
                                                    Unread
                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="empty-state">

                        <div class="empty-icon">
                            🔔
                        </div>

                        <h3>No notifications yet</h3>

                        <p>
                            Your system notifications will appear here automatically.
                        </p>

                    </div>
                }

            </div>

        </div>

    </div>

</body>

</html>