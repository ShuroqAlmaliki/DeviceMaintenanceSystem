@model IEnumerable<DeviceMaintenanceSystem.Models.MaintenanceRequest>

@{
    ViewData["Title"] = "Maintenance Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var totalRequests = Model?.Count() ?? 0;

    var pendingRequests = Model?.Count(x =>
        x.RequestStatus != null &&
        x.RequestStatus.ToLower() == "pending") ?? 0;

    var completedRequests = Model?.Count(x =>
        x.RequestStatus != null &&
        x.RequestStatus.ToLower() == "completed") ?? 0;
}


<div class="requests-page">

    <div class="requests-container">


        <!-- PAGE HEADER -->

        <div class="page-header">

            <div class="page-title">

                <div class="small-title">
                    MAINTENANCE MANAGEMENT
                </div>

                <h1>
                    Maintenance Requests
                </h1>

                <p>
                    View and manage all submitted maintenance requests.
                </p>

            </div>


            <a asp-controller="MaintenanceRequests"
               asp-action="Create"
               class="new-request">

                New Request
                <span>＋</span>

            </a>

        </div>


        <!-- STATISTICS -->

        <div class="stats">

            <div class="stat-card">

                <div class="stat-icon">
                    📋
                </div>

                <div class="stat-info">

                    <p>Total Requests</p>

                    <h2>
                        @totalRequests
                    </h2>

                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon">
                    ⏳
                </div>

                <div class="stat-info">

                    <p>Pending</p>

                    <h2>
                        @pendingRequests
                    </h2>

                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon">
                    ✓
                </div>

                <div class="stat-info">

                    <p>Completed</p>

                    <h2>
                        @completedRequests
                    </h2>

                </div>

            </div>

        </div>


        <!-- REQUESTS LIST -->

        <div class="requests-card">

            <div class="card-header">

                <h2>
                    Requests List
                </h2>

                <p>
                    All maintenance requests registered in the system.
                </p>

            </div>


            @if (Model != null && Model.Any())
            {
                <div class="table-wrapper">

                    <table class="requests-table">

                        <thead>

                            <tr>

                                <th>
                                    Request ID
                                </th>

                                <th>
                                    User Name
                                </th>

                                <th>
                                    Device Name
                                </th>

                                <th>
                                    Description
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Date
                                </th>

                                <th>
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        #@item.RequestId
                                    </td>

                                    <td>
                                        #@item.UserId
                                    </td>


                                    <td>
                                        @(item.Device?.DeviceName ?? "Unknown Device")
                                    </td>


                                    <td>
                                        @item.RequestDescription
                                    </td>


                                    <td>

                                        <span class="status">
                                            @item.RequestStatus
                                        </span>

                                    </td>


                                    <td>
                                        @item.RequestDate.ToString("dd/MM/yyyy")
                                    </td>


                                    <td>

                                        @if (item.RequestStatus != null &&
                                             item.RequestStatus.ToLower() == "pending")
                                        {
                                            <div class="actions">


                                                <!-- APPROVE -->

                                                <form asp-controller="MaintenanceRequests"
                                                      asp-action="Approve"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="requestid"
                                                           value="@item.RequestId" />

                                                    <button type="submit"
                                                            class="approve-btn">

                                                        Approve

                                                    </button>

                                                </form>


                                                <!-- REJECT -->

                                                <form asp-controller="MaintenanceRequests"
                                                      asp-action="Reject"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="requestid"
                                                           value="@item.RequestId" />

                                                    <button type="submit"
                                                            class="reject-btn">

                                                        Reject

                                                    </button>

                                                </form>

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="processed-text">
                                                Processed
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-icon">
                        🛠
                    </div>

                    <h3>
                        No maintenance requests yet
                    </h3>

                    <p>
                        New maintenance requests will appear here.
                    </p>

                </div>
            }

        </div>

    </div>

</div>