@model IEnumerable<DeviceMaintenanceSystem.Models.Department>

@{
    ViewData["Title"] = "Departments";
}

<div class="page-content">

    <div class="nova-card" style="max-width:1100px;margin:auto;">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div class="nova-card-heading">
                <span>DEVICE MAINTENANCE SYSTEM</span>
                <h2 style="color:darkcyan">Departments</h2>
                <p>.Manage all departments</p>
            </div>

            <a asp-action="Create" class="nova-signin"
               style="width:190px;height:50px;text-decoration:none;">
                + New Department
            </a>

        </div>

        <table class="table table-light table-hover align-middle">

            <thead>

                <tr>
                    <th>Action</th>
                    <th>Department</th>
                    <th>Head User</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="Edit"
                               asp-route-departmentid="@item.DepartmentId"
                               class="btn btn-warning btn-sm">
                                Edit
                            </a>
                        </td>
                        <td>@item.DepartmentName</td>
                        <td>@item.HeadUserName</td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>