@model IEnumerable<DeviceMaintenanceSystem.Models.Device>

@{
    ViewData["Title"] = "قائمة الأجهزة";
}

<link href="~/css/site.css" rel="stylesheet" />

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>إدارة الأجهزة</h2>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> إضافة جهاز جديد
        </a>
    </div>


    <div class="card shadow-sm">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover table-striped align-middle mb-0">

                    <thead class="table-dark">

                        <tr>
                            <th>رمز الجهاز (ID)</th>
                            <th>اسم الجهاز</th>
                            <th>النوع</th>
                            <th>الرقم التسلسلي</th>
                            <th>الحالة</th>
                            <th>الباركود</th>
                            <th>العمليات</th>
                        </tr>

                    </thead>


                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    لا توجد أجهزة مسجلة حالياً.
                                </td>
                            </tr>
                        }
                        else
                        {

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>@item.DeviceId</strong>
                                    </td>


                                    <td>
                                        @item.DeviceName
                                    </td>


                                    <td>
                                        @item.DeviceType
                                    </td>


                                    <td>
                                        @item.SerialNumber
                                    </td>


                                    <td>
                                        <span class="badge bg-info">
                                            @item.DeviceStatus
                                        </span>
                                    </td>


                                    <td>
                                        @item.BarcodeValue
                                    </td>


                                    <td>

                                        <div class="btn-group" role="group">

                                            <a asp-action="Edit"
                                               asp-route-id="@item.DeviceId"
                                               class="btn btn-sm btn-outline-warning">
                                                تعديل
                                            </a>


                                            <a asp-action="Details"
                                               asp-route-id="@item.DeviceId"
                                               class="btn btn-sm btn-outline-info">
                                                تفاصيل
                                            </a>


                                            <a asp-action="Delete"
                                               asp-route-id="@item.DeviceId"
                                               class="btn btn-sm btn-outline-danger">
                                                حذف
                                            </a>


                                            <!-- تم تعديل زر الباركود -->
                                            <a asp-action="PrintBarcode"
                                               asp-route-id="@item.DeviceId"
                                               class="btn btn-sm btn-outline-primary">
                                                طباعة الباركود
                                            </a>


                                        </div>

                                    </td>


                                </tr>
                            }

                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>