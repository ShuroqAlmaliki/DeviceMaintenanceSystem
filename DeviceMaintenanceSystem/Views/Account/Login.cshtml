@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div class="nova-login">

    <div class="nova-glow nova-glow-one"></div>
    <div class="nova-glow nova-glow-two"></div>

    <section class="nova-intro">

        <div class="nova-brand">
            <div class="nova-brand-mark">TU</div>

            <div>
                <strong>Taif University</strong>
                <span>Technical Support Department</span>
            </div>
        </div>

        <div class="nova-welcome">

            <span class="nova-label">SMART MAINTENANCE PLATFORM</span>

            <h1>
                One platform.<br />
                Faster support.
            </h1>

            <p>
                Manage devices, submit maintenance requests,
                and follow technical support updates in one secure place.
            </p>

            <div class="nova-features">

                <div class="nova-feature">
                    <div class="nova-feature-icon">
                        <svg viewBox="0 0 24 24">
                            <path d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3Z" />
                            <path d="m9 12 2 2 4-4" />
                        </svg>
                    </div>

                    <div>
                        <strong>Secure Access</strong>
                        <span>Protected university accounts</span>
                    </div>
                </div>

                <div class="nova-feature">
                    <div class="nova-feature-icon">
                        <svg viewBox="0 0 24 24">
                            <path d="M4 7h16v12H4z" />
                            <path d="M8 7V4h8v3M8 12h8M8 16h5" />
                        </svg>
                    </div>

                    <div>
                        <strong>Request Tracking</strong>
                        <span>Follow every maintenance request</span>
                    </div>
                </div>

                <div class="nova-feature">
                    <div class="nova-feature-icon">
                        <svg viewBox="0 0 24 24">
                            <path d="M3 5v4M3 15v4M7 5v14M12 5v14M16 5v14M21 5v4M21 15v4" />
                        </svg>
                    </div>

                    <div>
                        <strong>Device Barcode</strong>
                        <span>Quick access to device history</span>
                    </div>
                </div>

            </div>

        </div>

        <p class="nova-copyright">
            © 2026 Taif University
        </p>

    </section>

    <section class="nova-form-side">

        <div class="nova-card">

            <div class="nova-card-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M7 10V8a5 5 0 0 1 10 0v2" />
                    <rect x="4" y="10" width="16" height="11" rx="3" />
                    <path d="M12 14v3" />
                </svg>
            </div>

            <div class="nova-card-heading">
                <span>Welcome back</span>
                <h2>Sign in to continue</h2>
                <p>Enter your university account information.</p>
            </div>

            <form asp-controller="Account"
                  asp-action="Login"
                  method="post">

                @Html.AntiForgeryToken()

                @if (ViewBag.ErrorMessage != null)
                {
                    <div style="
                        margin-bottom: 16px;
                        padding: 12px 14px;
                        border: 1px solid rgba(255,110,110,0.35);
                        border-radius: 10px;
                        background: rgba(255,90,90,0.10);
                        color: #ff9c9c;
                        font-size: 13px;">
                        @ViewBag.ErrorMessage
                    </div>
                }

                <div class="nova-field">
                    <label for="username">User Name</label>

                    <div class="nova-input">
                        <svg viewBox="0 0 24 24">
                            <circle cx="12" cy="8" r="4" />
                            <path d="M4 21a8 8 0 0 1 16 0" />
                        </svg>

                        <input id="username"
                               name="username"
                               type="text"
                               placeholder="Enter your username"
                               autocomplete="username"
                               required />
                    </div>
                </div>

                <div class="nova-field">
                    <div class="nova-label-row">
                        <label for="password">Password</label>
                        <a href="#">Forgot password?</a>
                    </div>

                    <div class="nova-input">
                        <svg viewBox="0 0 24 24">
                            <rect x="4" y="10" width="16" height="11" rx="3" />
                            <path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3" />
                        </svg>

                        <input id="password"
                               name="password"
                               type="password"
                               placeholder="Enter your password"
                               autocomplete="current-password"
                               required />

                        <button class="nova-eye"
                                type="button"
                                aria-label="Show password"
                                onclick="togglePassword()">

                            <svg viewBox="0 0 24 24">
                                <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" />
                                <circle cx="12" cy="12" r="2.5" />
                            </svg>

                        </button>
                    </div>
                </div>

                <label class="nova-remember">
                    <input type="checkbox"
                           name="rememberMe"
                           value="true" />
                    <span>Remember me</span>
                </label>

                <button class="nova-signin"
                        type="submit">

                    <span>Sign In</span>

                    <svg viewBox="0 0 24 24">
                        <path d="M5 12h14M14 7l5 5-5 5" />
                    </svg>

                </button>

            </form>

            <div class="nova-divider">
                <span>or continue with</span>
            </div>

            <button class="nova-tu-button"
                    type="button">

                <span class="nova-mini-logo">TU</span>

                Sign in with TU Account

            </button>

            <p class="nova-help">
                Having trouble signing in?
                <a href="#">Contact IT Support</a>
            </p>

        </div>

    </section>

</div>

<script>
    function togglePassword() {
        const passwordInput = document.getElementById("password");

        passwordInput.type =
            passwordInput.type === "password"
                ? "text"
                : "password";
    }
</script>