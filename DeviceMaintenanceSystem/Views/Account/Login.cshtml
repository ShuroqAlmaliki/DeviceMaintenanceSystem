@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div class="nova-login">

    <div class="nova-glow nova-glow-one"></div>
    <div class="nova-glow nova-glow-two"></div>

    <!-- =========================================
         LEFT SIDE
         ========================================= -->
    <section class="nova-intro">

        <!-- University -->
        <div class="nova-brand">

            <div class="nova-brand-mark">TU</div>

            <div>
                <strong>Taif University</strong>
                <span>Technical Support Department</span>
            </div>

        </div>


        <!-- Platform Information -->
        <div class="nova-welcome nova-welcome-simple">

            <span class="nova-label">
                SMART MAINTENANCE PLATFORM
            </span>


            <!-- Maintenance Illustration -->
            <div class="nova-maintenance-visual">

                <div class="nova-visual-glow"></div>

                <svg class="nova-maintenance-svg"
                     viewBox="0 0 620 400"
                     xmlns="http://www.w3.org/2000/svg">

                    <!-- Background Circle -->
                    <circle cx="310"
                            cy="190"
                            r="150"
                            class="visual-circle" />


                    <!-- Monitor -->
                    <rect x="160"
                          y="80"
                          width="300"
                          height="205"
                          rx="22"
                          class="visual-monitor" />

                    <rect x="180"
                          y="100"
                          width="260"
                          height="165"
                          rx="12"
                          class="visual-screen" />


                    <!-- Screen Header -->
                    <circle cx="205"
                            cy="122"
                            r="5"
                            class="visual-dot" />

                    <circle cx="222"
                            cy="122"
                            r="5"
                            class="visual-dot visual-dot-light" />

                    <circle cx="239"
                            cy="122"
                            r="5"
                            class="visual-dot visual-dot-light" />


                    <!-- Screen Content -->
                    <rect x="205"
                          y="153"
                          width="105"
                          height="12"
                          rx="6"
                          class="visual-line" />

                    <rect x="205"
                          y="177"
                          width="185"
                          height="8"
                          rx="4"
                          class="visual-line-light" />

                    <rect x="205"
                          y="196"
                          width="145"
                          height="8"
                          rx="4"
                          class="visual-line-light" />


                    <!-- Status Card -->
                    <rect x="205"
                          y="220"
                          width="105"
                          height="27"
                          rx="8"
                          class="visual-status" />

                    <path d="M222 233 L228 239 L240 226"
                          class="visual-check" />


                    <!-- Monitor Stand -->
                    <path d="M285 285 L275 325 H345 L335 285"
                          class="visual-stand" />

                    <rect x="245"
                          y="323"
                          width="130"
                          height="16"
                          rx="8"
                          class="visual-stand-base" />


                    <!-- Gear -->
                    <g class="visual-gear">

                        <circle cx="440"
                                cy="245"
                                r="55"
                                class="gear-outer" />

                        <circle cx="440"
                                cy="245"
                                r="23"
                                class="gear-inner" />

                        <path d="M440 177 V194
                        M440 296 V313
                        M372 245 H389
                        M491 245 H508
                        M392 197 L404 209
                        M476 281 L488 293
                        M392 293 L404 281
                        M476 209 L488 197"
                              class="gear-lines" />

                    </g>


                    <!-- Tool -->
                    <g class="visual-tool">

                        <path d="M150 205
                        C120 190 105 160 115 130
                        L145 160
                        L170 135
                        L140 105
                        C170 95 200 110 212 140
                        C222 165 215 188 198 205
                        L135 268
                        C125 278 108 278 98 268
                        C88 258 88 241 98 231
                        Z"
                              class="tool-shape" />

                        <circle cx="118"
                                cy="249"
                                r="8"
                                class="tool-hole" />

                    </g>

                </svg>

            </div>


            <!-- Platform Description -->
            <p class="nova-platform-description">
                Manage devices, submit maintenance requests,
                and follow technical support updates in one secure place.
            </p>

        </div>


        <p class="nova-copyright">
            © 2026 Taif University
        </p>

    </section>


    <!-- =========================================
         LOGIN SIDE
         ========================================= -->
    <section class="nova-form-side">

        <div class="nova-card">

            <div class="nova-card-icon">

                <svg viewBox="0 0 24 24">

                    <path d="M7 10V8a5 5 0 0 1 10 0v2" />

                    <rect x="4"
                          y="10"
                          width="16"
                          height="11"
                          rx="3" />

                    <path d="M12 14v3" />

                </svg>

            </div>


            <div class="nova-card-heading">

                <span>Welcome back</span>

                <h2>Sign in to continue</h2>

                <p>
                    Enter your university account information.
                </p>

            </div>


            <form asp-controller="Account"
                  asp-action="Login"
                  method="post">

                @Html.AntiForgeryToken()


                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="nova-error-message">
                        @ViewBag.ErrorMessage
                    </div>
                }


                <!-- User Name -->
                <div class="nova-field">

                    <label for="username">
                        User Name
                    </label>

                    <div class="nova-input">

                        <svg viewBox="0 0 24 24">

                            <circle cx="12"
                                    cy="8"
                                    r="4" />

                            <path d="M4 21a8 8 0 0 1 16 0" />

                        </svg>


                        <input id="username"
                               name="username"
                               type="text"
                               placeholder="Enter your username"
                               autocomplete="username"
                               required />

                    </div>

                </div>


                <!-- Password -->
                <div class="nova-field">

                    <div class="nova-label-row">

                        <label for="password">
                            Password
                        </label>

                        <a href="#">
                            Forgot password?
                        </a>

                    </div>


                    <div class="nova-input">

                        <svg viewBox="0 0 24 24">

                            <rect x="4"
                                  y="10"
                                  width="16"
                                  height="11"
                                  rx="3" />

                            <path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3" />

                        </svg>


                        <input id="password"
                               name="password"
                               type="password"
                               placeholder="Enter your password"
                               autocomplete="current-password"
                               required />


                        <button class="nova-eye"
                                type="button"
                                aria-label="Show password"
                                onclick="togglePassword()">

                            <svg viewBox="0 0 24 24">

                                <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" />

                                <circle cx="12"
                                        cy="12"
                                        r="2.5" />

                            </svg>

                        </button>

                    </div>

                </div>


                <!-- Remember Me -->
                <label class="nova-remember">

                    <input type="checkbox"
                           name="rememberMe"
                           value="true" />

                    <span>
                        Remember me
                    </span>

                </label>


                <!-- Sign In -->
                <button class="nova-signin"
                        type="submit">

                    <span>
                        Sign In
                    </span>

                    <svg viewBox="0 0 24 24">
                        <path d="M5 12h14M14 7l5 5-5 5" />
                    </svg>

                </button>

            </form>


            <div class="nova-divider">
                <span>or continue with</span>
            </div>


            <button class="nova-tu-button"
                    type="button">

                <span class="nova-mini-logo">
                    TU
                </span>

                Sign in with TU Account

            </button>


            <p class="nova-help">

                Having trouble signing in?

                <a href="#">
                    Contact IT Support
                </a>

            </p>

        </div>

    </section>

</div>


<script>

    function togglePassword() {

        const passwordInput =
            document.getElementById("password");

        passwordInput.type =
            passwordInput.type === "password"
                ? "text"
                : "password";
    }

</script>