@model DeviceMaintenanceSystem.Models.Device

@{
    ViewData["Title"] = "Delete Device";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="device-delete-page">

    <div class="device-delete-container">

        <div class="device-form-header">

            <div>

                <div class="device-page-label device-danger-label">
                    DELETE DEVICE
                </div>

                <h1>Delete Device</h1>

                <p>
                    Review the device information before deleting it.
                </p>

            </div>


            <a asp-action="Index"
               class="device-back-button">
                ← Back to Devices
            </a>

        </div>


        <div class="device-delete-card">

            <div class="device-delete-warning">

                <div class="device-warning-icon">
                    !
                </div>

                <div>

                    <h2>
                        Are you sure you want to delete this device?
                    </h2>

                    <p>
                        This action cannot be undone.
                    </p>

                </div>

            </div>


            <div class="device-details-grid">

                <div class="device-detail-item">

                    <span>Device ID</span>

                    <strong>
                        @Model.DeviceId
                    </strong>

                </div>


                <div class="device-detail-item">

                    <span>Device Name</span>

                    <strong>
                        @Model.DeviceName
                    </strong>

                </div>


                <div class="device-detail-item">

                    <span>Device Type</span>

                    <strong>
                        @Model.DeviceType
                    </strong>

                </div>


                <div class="device-detail-item">

                    <span>Serial Number</span>

                    <strong>
                        @Model.SerialNumber
                    </strong>

                </div>


                <div class="device-detail-item">

                    <span>Status</span>

                    <strong>
                        @Model.DeviceStatus
                    </strong>

                </div>


                <div class="device-detail-item">

                    <span>Department</span>

                    <strong>
                        @(Model.Department?.DepartmentName
                            ?? $"Department #{Model.DepartmentId}")
                    </strong>

                </div>

            </div>


            <form asp-action="Delete"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="DeviceId" />


                <div class="device-delete-actions">

                    <button type="submit"
                            class="device-danger-button">
                        Delete Device
                    </button>

                    <a asp-action="Index"
                       class="device-secondary-button">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>