@model DeviceMaintenanceSystem.Models.Device

@{
    ViewData["Title"] = "Device QR Code";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="device-barcode-page">

    <div class="device-barcode-container">


        <!-- =========================================
             HEADER
             ========================================= -->

        <div class="device-form-header no-print">

            <div>

                <div class="device-page-label">
                    DEVICE QR CODE
                </div>

                <h1>
                    Device QR Code
                </h1>

                <p>
                    Scan the QR code to open the device information.
                </p>

            </div>


            <a asp-controller="Devices"
               asp-action="Index"
               class="device-back-button">

                ← Back to Devices

            </a>

        </div>


        <!-- =========================================
             QR CARD
             ========================================= -->

        <div class="device-barcode-card">


            <!-- DEVICE INFORMATION -->

            <div class="device-barcode-heading">

                <div class="device-barcode-device-icon">

                    <svg viewBox="0 0 24 24">

                        <rect x="4"
                              y="5"
                              width="16"
                              height="12"
                              rx="2">
                        </rect>

                        <path d="M8 21h8">
                        </path>

                        <path d="M12 17v4">
                        </path>

                    </svg>

                </div>


                <div>

                    <span>
                        Device
                    </span>

                    <h2>
                        @Model.DeviceName
                    </h2>

                    <p>
                        ID: @Model.DeviceId
                    </p>

                </div>

            </div>


            <!-- =====================================
                 QR CODE
                 ===================================== -->

            <div class="device-barcode-preview">

                <div class="device-barcode-title">
                    DEVICE QR CODE
                </div>


                @if (ViewBag.BarcodeImage != null)
                {
                    <img src="@ViewBag.BarcodeImage"
                         alt="Device QR Code"
                         class="device-barcode-image" />
                }


                @if (ViewBag.BarcodeImage == null)
                {
                    <div class="device-barcode-unavailable">

                        QR code image is unavailable.

                    </div>
                }


                <div class="device-barcode-value">

                    Scan to view device details

                </div>


                @if (ViewBag.DeviceUrl != null)
                {
                    <div class="device-barcode-value">

                        @ViewBag.DeviceUrl

                    </div>
                }

            </div>


            <!-- =====================================
                 ACTIONS
                 ===================================== -->

            <div class="device-barcode-actions no-print">


                <button type="button"
                        onclick="window.print()"
                        class="device-primary-button">

                    Print QR Code

                </button>


                <a asp-controller="Devices"
                   asp-action="Details"
                   asp-route-id="@Model.DeviceId"
                   class="device-secondary-button">

                    View Device

                </a>


                <a asp-controller="Devices"
                   asp-action="Index"
                   class="device-secondary-button">

                    Back to Devices

                </a>

            </div>

        </div>

    </div>

</div>