@model DeviceMaintenanceSystem.Models.Device

@using DeviceMaintenanceSystem.Models

@{
    ViewData["Title"] = "Maintenance Log";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var maintenanceLogs =
        ViewBag.MaintenanceLogs as List<MaintenanceLog>
        ?? new List<MaintenanceLog>();

    var maintenanceCount =
        ViewBag.MaintenanceCount != null
            ? (int)ViewBag.MaintenanceCount
            : maintenanceLogs.Count;
}


<div class="requests-page">

    <div class="requests-container">


        <!-- =========================================
             PAGE HEADER
             ========================================= -->

        <div class="page-header">

            <div class="page-title">

                <div class="small-title">
                    DEVICE MAINTENANCE
                </div>

                <h1>
                    Maintenance Log
                </h1>

                <p>
                    View the maintenance history for this device.
                </p>

            </div>

        </div>


        <!-- =========================================
             DEVICE INFORMATION
             ========================================= -->

        <div class="requests-card">

            <div class="card-header">

                <h2>
                    @Model.DeviceName
                </h2>

                <p>
                    Device ID: @Model.DeviceId
                </p>

            </div>


            <div style="padding: 25px;">

                <p>
                    <strong>Device Type:</strong>
                    @Model.DeviceType
                </p>


                <p>
                    <strong>Serial Number:</strong>
                    @Model.SerialNumber
                </p>


                <p>
                    <strong>Current Status:</strong>

                    <span class="status">
                        @Model.DeviceStatus
                    </span>
                </p>


                <p>
                    <strong>Department:</strong>

                    @(Model.Department?.DepartmentName
                        ?? "Not Assigned")
                </p>


                <p>
                    <strong>Total Maintenance Times:</strong>
                    @maintenanceCount
                </p>

            </div>

        </div>


        <!-- =========================================
             MAINTENANCE HISTORY
             ========================================= -->

        <div class="requests-card"
             style="margin-top: 25px;">

            <div class="card-header">

                <h2>
                    Maintenance History
                </h2>

                <p>
                    Repair records performed on device @Model.DeviceId.
                </p>

            </div>


            @if (maintenanceLogs.Any())
            {
                <div class="table-wrapper">

                    <table class="requests-table">

                        <thead>

                            <tr>

                                <th>
                                    Log ID
                                </th>

                                <th>
                                    Request ID
                                </th>

                                <th>
                                    Technician
                                </th>

                                <th>
                                    Repair Details
                                </th>

                                <th>
                                    Start Date
                                </th>

                                <th>
                                    End Date
                                </th>

                                <th>
                                    Device Status
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var log in maintenanceLogs)
                            {
                                <tr>

                                    <td>
                                        #@log.LogId
                                    </td>


                                    <td>
                                        #@log.RequestId
                                    </td>


                                    <td>
                                        @log.UserId
                                    </td>


                                    <td>
                                        @log.RepairDetails
                                    </td>


                                    <td>
                                        @(log.RepairStartDate.ToString("dd/MM/yyyy HH:mm"))
                                    </td>


                                    <td>
                                        @(log.RepairEndDate.ToString("dd/MM/yyyy HH:mm"))
                                    </td>


                                    <td>

                                        <span class="status">
                                            @log.DeviceStatusAfterRepair
                                        </span>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }


            @if (!maintenanceLogs.Any())
            {
                <div class="empty-state">

                    <div class="empty-icon">
                        🛠
                    </div>

                    <h3>
                        No Maintenance Records
                    </h3>

                    <p>
                        Device @Model.DeviceId does not have any maintenance records yet.
                    </p>

                </div>
            }

        </div>


        <!-- =========================================
             BACK BUTTON
             ========================================= -->

        <div style="margin-top: 25px;">

            <a asp-controller="Devices"
               asp-action="Details"
               asp-route-id="@Model.DeviceId"
               class="new-request">

                Back to Device

            </a>

        </div>

    </div>

</div>